# Database: SQLite works by default; use PostgreSQL in deployed environments.
DATABASE_URL=sqlite:///./gtm_signal_hub.db

# Optional AI reasoning. Leave blank to use deterministic evidence-grounded reasoning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional protection for Clay -> Signal Hub requests.
CLAY_WEBHOOK_TOKEN=

# Streamlit dashboard backend URL.
API_URL=http://localhost:8000
